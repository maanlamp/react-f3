{
  "name": "react-f3",
  "version": "4.0.0",
  "type": "module",
  "description": "Components, hooks & utilities for creating and managing delightfully simple form experiences in React.",
  "keywords": [
    "react",
    "form",
    "forms",
    "hook",
    "hooks",
    "typescript",
    "typesafe",
    "type-safe",
    "zod",
    "validation"
  ],
  "homepage": "https://github.com/maanlamp/react-f3",
  "author": "Wouter Lem (https://github.com/maanlamp)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maanlamp/react-f3.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/react-f3.d.ts",
      "default": "./dist/react-f3.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/react-f3.js",
  "types": "dist/react-f3.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "24.9.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vite-plugin-dts": "4.5.4"
  }
}
